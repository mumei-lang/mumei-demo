{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mumei-lang/mumei-demo/specimens/DEFECTS.schema.json",
  "title": "Planted defect ground truth for one specimen",
  "type": "object",
  "additionalProperties": false,
  "required": ["specimen", "language", "kind", "summary", "defects"],
  "properties": {
    "specimen": {"type": "string", "pattern": "^(py|ts|go|rs|sol)-[0-9]{2}-[a-z0-9-]+$"},
    "language": {"enum": ["python", "typescript", "go", "rust", "solidity"]},
    "kind": {"enum": ["web", "cli", "library", "contract"]},
    "summary": {"type": "string", "minLength": 1},
    "defects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "function", "line", "anchor", "class", "category", "cwe", "title", "description", "trigger", "observed", "repro"],
        "properties": {
          "id": {"type": "string", "pattern": "^(PY|TS|GO|RS|SOL)[0-9]{2}-D[0-9]{2}$"},
          "file": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "anchor": {"type": "string", "minLength": 1},
          "class": {"enum": ["bug", "design", "vulnerability"]},
          "category": {
            "enum": [
              "integer-overflow",
              "integer-underflow",
              "division-by-zero",
              "out-of-bounds",
              "off-by-one",
              "null-dereference",
              "missing-precondition",
              "invariant-violation",
              "invalid-state-transition",
              "float-money",
              "rounding-error",
              "logic-error",
              "error-handling",
              "race-condition",
              "toctou",
              "resource-leak",
              "unbounded-resource",
              "sql-injection",
              "command-injection",
              "path-traversal",
              "xss",
              "ssrf",
              "open-redirect",
              "insecure-deserialization",
              "missing-authentication",
              "missing-authorization",
              "idor",
              "hardcoded-secret",
              "weak-crypto",
              "insecure-randomness",
              "timing-side-channel",
              "redos",
              "information-exposure",
              "mass-assignment",
              "reentrancy",
              "access-control",
              "tx-origin-auth",
              "unchecked-call",
              "front-running",
              "timestamp-dependence",
              "denial-of-service",
              "signature-replay"
            ]
          },
          "cwe": {"type": ["string", "null"], "pattern": "^CWE-[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "observed": {"type": "string", "minLength": 1},
          "repro": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        }
      }
    }
  }
}
