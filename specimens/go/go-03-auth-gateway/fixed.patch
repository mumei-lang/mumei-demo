+func randomHex(n int) string {
+	buf := make([]byte, n)
+	if _, err := rand.Read(buf); err != nil {
+		panic(err)
+	}
+	return hex.EncodeToString(buf)
+}
+
+func seedUsers() map[string]*user {
+	accounts := map[string]*user{
+		"alice": newUser("alice", "reader", "bluebird42"),
+		"bob":   newUser("bob", "reader", "bluebird42"),
+	}
+	if password := os.Getenv("ADMIN_PASSWORD"); password != "" {
+		accounts["admin"] = newUser("admin", "admin", password)
+	}
+	return accounts
+}
+
+func newUser(name, role, password string) *user {
+	salt := make([]byte, 16)
+	if _, err := rand.Read(salt); err != nil {
+		panic(err)
+	}
+	return &user{Name: name, Role: role, Salt: salt, PasswordHash: hashPassword(password, salt)}
+}
+
+// hashPassword derives a 32-byte key with PBKDF2-HMAC-SHA256.
+func hashPassword(password string, salt []byte) []byte {
+	mac := hmac.New(sha256.New, []byte(password))
+	mac.Write(salt)
+	mac.Write(binary.BigEndian.AppendUint32(nil, 1))
+	block := mac.Sum(nil)
+	out := append([]byte(nil), block...)
+	for i := 1; i < passwordIterations; i++ {
+		mac.Reset()
+		mac.Write(block)
+		block = mac.Sum(block[:0])
+		for j := range out {
+			out[j] ^= block[j]
+		}
+	}
+	return out
+}
+
+func passwordMatches(account *user, password string) bool {
+	return subtle.ConstantTimeCompare(hashPassword(password, account.Salt), account.PasswordHash) == 1
+}
