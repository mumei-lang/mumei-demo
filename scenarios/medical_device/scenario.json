{
  "name": "Medical Device Control: Insulin Pump Safety",
  "version": "1.0.0",
  "description": "インスリンポンプの投与量制御におけるオーバードーズ脆弱性をZ3が検出し、境界チェックと任意のLean証明で安全性を検証するデモ",
  "layers": ["l1_z3", "l3_lean"],
  "narrative": {
    "intro": [
      "Step 1: LLM generates insulin pump dosage control code...",
      "Step 2: mumei verifies dosage bounds and safety invariants..."
    ],
    "before": "deliver_insulin 関数が血糖値に基づく上限チェックをスキップし、過剰投与の可能性",
    "after": "境界チェックと単調性保存で修正し、投与量の安全性を任意のLean証明で確認",
    "steps": {
      "detect_bug": {
        "rejected": {
          "icon": "❌",
          "headline": "BUG DETECTED! Dosage transition skips safety guard",
          "follow_up": [
            "  Insulin delivery must pass through the SafetyChecked state.",
            "  Buggy implementation delivers from Idle without the hourly-limit guard.",
            "",
            "  Step 3: Verifying the guarded implementation..."
          ]
        }
      },
      "verify_correct": {
        "pass": {
          "icon": "✅",
          "headline": "Z3 verified dosage bounds and guarded delivery",
          "follow_up": [
            "  delivered_amount <= max_dose_per_hour - current_hour_dosage",
            "  glucose_level check ensures hypoglycemia prevention.",
            "",
            "  Step 4: Optional Lean proof checks cumulative dosage safety..."
          ]
        }
      },
      "lean_build": {
        "certified": {
          "icon": "✅",
          "headline": "CERTIFIED: no_overdose_with_hourly_limit"
        }
      }
    }
  },
  "l1_z3": {
    "steps": [
      {
        "id": "detect_bug",
        "name": "Z3 Bug Detection: unguarded insulin delivery",
        "repo": "mumei",
        "command": "{mumei_bin} verify {root_dir}/scenarios/medical_device/buggy_code.mm",
        "expected_exit": 1,
        "expect_failure": true,
        "expected_patterns": ["InvalidPreState"],
        "artifacts": []
      },
      {
        "id": "verify_correct",
        "name": "Z3 Correct Dosage Control Verification",
        "repo": "mumei",
        "command": "{mumei_bin} verify {root_dir}/scenarios/medical_device/correct_code.mm --proof-cert --output {output_dir}/medical_device.proof.json",
        "expected_exit": 0,
        "expected_patterns": ["Verification passed", "deliver_insulin"],
        "artifacts": ["medical_device.proof.json"]
      }
    ]
  },
  "l3_lean": {
    "steps": [
      {
        "id": "lean_build",
        "name": "Lean Medical Device Proof Build",
        "repo": "mumei-lean",
        "command": "lake build MumeiLean.MedicalDevice",
        "cwd": "{mumei_lean_repo}",
        "expected_exit": 0,
        "expected_patterns": [],
        "artifacts": [],
        "optional_toolchain": "lake",
        "optional_path": "{mumei_lean_repo}/MumeiLean/MedicalDevice.lean"
      },
      {
        "id": "lean_bridge",
        "name": "Lean Bridge Certificate",
        "repo": "mumei-lean",
        "command": "python3 {mumei_lean_repo}/scripts/bridge.py --cert {output_dir}/medical_device.proof.json --lean-cert-out {output_dir}/medical_device.lean-cert.json --no-build",
        "expected_exit": 0,
        "expected_patterns": ["dry run: skipping `lake build`"],
        "artifacts": ["medical_device.lean-cert.json"],
        "depends_on": ["verify_correct", "lean_build"],
        "optional_toolchain": "lake"
      }
    ]
  }
}
